[Unit]
Description=Check CEP front container and public endpoint
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/cep-front-healthcheck
TimeoutStartSec=30s
UMask=0077
Environment=HEALTH_URL=https://app.cep.lat/healthz
StandardOutput=journal
StandardError=journal

