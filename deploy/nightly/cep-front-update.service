[Unit]
Description=Deploy tested CEP front updates at 02:15 Sao Paulo
Wants=network-online.target
After=network-online.target docker.service cep-api-update.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/cep-front
ExecStart=/usr/bin/flock -n /run/lock/cep-front-update.lock /usr/local/sbin/cep-front-nightly-deploy
TimeoutStartSec=30min
TimeoutStopSec=5min
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
Environment=GIT_TERMINAL_PROMPT=0
StandardOutput=journal
StandardError=journal

