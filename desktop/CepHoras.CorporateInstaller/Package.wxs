<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="CEP Horas" Manufacturer="Conceito" Version="$(var.InstallerVersion)"
           Language="1046" Codepage="1252" UpgradeCode="8D0D0DC8-E744-42E7-A57A-20F489145ED8" Scope="perMachine">
    <SummaryInformation Description="CEP Horas com aplicativo WebView2, serviço de controle de energia e inicialização automática" />
    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="Já existe uma versão mais recente do CEP Horas." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="medium" />
    <Launch Condition="Installed OR VersionNT64" Message="Requer Windows x64." />
    <Property Id="ARPCOMMENTS" Value="Instalação corporativa do CEP Horas. As ações de energia são autorizadas pela CEP API e executadas pelo serviço local." />

    <CustomAction Id="RollbackApplyPolicy" FileRef="ControlExe" ExeCommand="--rollback-apply" Execute="rollback" Impersonate="no" Return="check" />
    <CustomAction Id="ApplyPolicy" FileRef="ControlExe" ExeCommand="--apply-policy" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="RollbackPolicyRestore" FileRef="ControlExe" ExeCommand="--rollback-restore" Execute="rollback" Impersonate="no" Return="check" />
    <CustomAction Id="RestorePolicy" FileRef="ControlExe" ExeCommand="--uninstall-restore" Execute="deferred" Impersonate="no" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="RollbackApplyPolicy" Before="ApplyPolicy" Condition="NOT Installed" />
      <Custom Action="ApplyPolicy" After="InstallFiles" Condition="NOT Installed" />
      <Custom Action="RollbackPolicyRestore" Before="RestorePolicy" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RestorePolicy" Before="StopServices" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Conceito CEP Horas" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="CorporateAutoStart" Guid="76184352-3515-4E5D-AC7D-769A3223C7BB">
        <CreateFolder>
          <PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)" />
        </CreateFolder>
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="CepHoras" Value="&quot;[INSTALLFOLDER]CepHoras.exe&quot; --background" Type="string" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <Feature Id="MainFeature" Title="CEP Horas" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="CorporateAutoStart" />
    </Feature>
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="PilotNotice.rtf" />
  </Package>
</Wix>
