<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="CEP Horas" Manufacturer="Conceito" Version="$(var.InstallerVersion)"
           Language="1046" Codepage="1252" UpgradeCode="8D0D0DC8-E744-42E7-A57A-20F489145ED8" Scope="perMachine">
    <SummaryInformation Description="CEP Horas com aplicativo WebView2, serviço de controle de energia e inicialização automática" />
    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="Já existe uma versão mais recente do CEP Horas." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="medium" />
    <Launch Condition="Installed OR VersionNT64" Message="Requer Windows x64." />
    <Property Id="CEP_WINDOWS_BUILD" Secure="yes">
      <RegistrySearch Id="WindowsBuild" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="CEP_WINDOWS_TYPE" Secure="yes">
      <RegistrySearch Id="WindowsType" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="InstallationType" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="CEP_WINDOWS_EDITION" Secure="yes">
      <RegistrySearch Id="WindowsEdition" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="EditionID" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="CEP_WEBVIEW2_MACHINE" Secure="yes">
      <RegistrySearch Id="MachineWebView2" Root="HKLM" Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" Name="pv" Type="raw" Bitness="always32" />
    </Property>
    <Launch Condition="Installed OR ((CEP_WINDOWS_BUILD = 19045 OR CEP_WINDOWS_BUILD &gt;= 26100) AND CEP_WINDOWS_TYPE = &quot;Client&quot; AND (CEP_WINDOWS_EDITION &lt;&lt; &quot;Professional&quot; OR CEP_WINDOWS_EDITION &lt;&lt; &quot;Enterprise&quot; OR CEP_WINDOWS_EDITION &lt;&lt; &quot;Education&quot;))" Message="Requer Windows 10 22H2 ou Windows 11 24H2 ou superior, x64 Pro, Enterprise ou Education. Home e Server não são suportados pelo controle corporativo." />
    <Launch Condition="Installed OR (CEP_WEBVIEW2_MACHINE AND CEP_WEBVIEW2_MACHINE &lt;&gt; &quot;0.0.0.0&quot;)" Message="Instale o Microsoft Edge WebView2 Evergreen Runtime por máquina antes de instalar o CEP Horas. O Runtime somente no perfil do administrador não atende os outros usuários." />
    <Property Id="ARPCOMMENTS" Value="Instalação corporativa do CEP Horas. As ações de energia são autorizadas pela CEP API e executadas pelo serviço local." />

    <CustomAction Id="RollbackApplyPolicy" FileRef="ControlExe" ExeCommand="--rollback-apply" Execute="rollback" Impersonate="no" Return="check" />
    <CustomAction Id="ApplyPolicy" FileRef="ControlExe" ExeCommand="--apply-policy" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="RollbackPolicyRestore" FileRef="ControlExe" ExeCommand="--rollback-restore" Execute="rollback" Impersonate="no" Return="check" />
    <CustomAction Id="RestorePolicy" FileRef="ControlExe" ExeCommand="--uninstall-restore" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="RollbackPolicyUpgrade" FileRef="ControlExe" ExeCommand="--rollback-policy-upgrade" Execute="rollback" Impersonate="no" Return="check" />
    <CustomAction Id="UpgradePolicy" FileRef="ControlExe" ExeCommand="--upgrade-policy" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="FinishPolicyUpgrade" FileRef="ControlExe" ExeCommand="--finish-policy-upgrade" Execute="commit" Impersonate="no" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="RollbackApplyPolicy" Before="ApplyPolicy" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
      <Custom Action="ApplyPolicy" After="InstallFiles" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
      <Custom Action="RollbackPolicyRestore" Before="RestorePolicy" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RestorePolicy" After="StopServices" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RollbackPolicyUpgrade" Before="UpgradePolicy" Condition="NOT Installed AND WIX_UPGRADE_DETECTED" />
      <Custom Action="UpgradePolicy" After="InstallFiles" Condition="NOT Installed AND WIX_UPGRADE_DETECTED" />
      <Custom Action="FinishPolicyUpgrade" After="UpgradePolicy" Condition="NOT Installed AND WIX_UPGRADE_DETECTED" />
    </InstallExecuteSequence>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Conceito CEP Horas" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="CorporateAutoStart" Guid="76184352-3515-4E5D-AC7D-769A3223C7BB">
        <CreateFolder>
          <PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)" />
        </CreateFolder>
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="CepHoras" Value="&quot;[INSTALLFOLDER]CepHoras.exe&quot; --background" Type="string" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <Feature Id="MainFeature" Title="CEP Horas" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="CorporateAutoStart" />
    </Feature>
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="PilotNotice.rtf" />
  </Package>
</Wix>
