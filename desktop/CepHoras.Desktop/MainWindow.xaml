<Window x:Class="CepHoras.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="CEP Horas · Conceito Engenharia" Width="1280" Height="860" MinWidth="400" MinHeight="600" WindowStartupLocation="CenterScreen" Background="#F5F5F3">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border x:Name="UpdateBanner" Grid.Row="0" Visibility="Collapsed" Background="#FFF0E6" BorderBrush="#DA5D1E" BorderThickness="0,0,0,1" Padding="12">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="UpdateNowButton" Content="Atualizar" Click="UpdateNow_Click" Padding="12,6" Margin="8,0,0,0" />
          <Button x:Name="UpdateLaterButton" Content="Depois" Click="UpdateLater_Click" Padding="12,6" Margin="8,0,0,0" />
        </StackPanel>
        <TextBlock x:Name="UpdateMessage" Text="Nova versão disponível." VerticalAlignment="Center" TextWrapping="Wrap" />
      </DockPanel>
    </Border>
    <TextBlock x:Name="StartupStatus" Grid.Row="1" Text="Preparando seu espaço…" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="#555750" TextWrapping="Wrap" Margin="40" />
    <wv:WebView2 x:Name="Browser" Grid.Row="1" Visibility="Hidden" />
  </Grid>
</Window>
