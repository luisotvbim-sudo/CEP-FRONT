<Window x:Class="CepHoras.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="CEP Horas · Conceito Engenharia" Width="1280" Height="860" MinWidth="400" MinHeight="600" WindowStartupLocation="CenterScreen" Background="#F5F5F3">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border x:Name="UpdateBanner" Grid.Row="0" Visibility="Collapsed" Background="#FFF0E6" BorderBrush="#DA5D1E" BorderThickness="0,0,0,1" Padding="12">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="UpdateNowButton" Content="Atualizar" Click="UpdateNow_Click" Padding="12,6" Margin="8,0,0,0" />
          <Button x:Name="UpdateLaterButton" Content="Depois" Click="UpdateLater_Click" Padding="12,6" Margin="8,0,0,0" />
        </StackPanel>
        <TextBlock x:Name="UpdateMessage" Text="Nova versão disponível." VerticalAlignment="Center" TextWrapping="Wrap" />
      </DockPanel>
    </Border>
    <Border x:Name="ShutdownTestBanner" Grid.Row="1" Visibility="Collapsed" Background="#FFF0E6" BorderBrush="#DA5D1E" BorderThickness="0,0,0,1" Padding="12">
      <DockPanel>
        <Button x:Name="ShutdownTestButton" DockPanel.Dock="Right" Content="Autorizar desligamento…" Click="ShutdownTest_Click" Padding="12,6" Margin="12,0,0,0" />
        <TextBlock x:Name="ShutdownTestStatus" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555750" />
      </DockPanel>
    </Border>
    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="680" Margin="32">
      <TextBlock x:Name="StartupStatus" Text="Preparando seu espaço…" FontSize="16" Foreground="#555750" TextWrapping="Wrap" TextAlignment="Center" />
      <Button x:Name="RetryStartupButton" Content="Já encerrei a outra versão — tentar novamente" Click="RetryStartup_Click"
              Visibility="Collapsed" HorizontalAlignment="Center" Padding="16,10" Margin="0,20,0,0" />
    </StackPanel>
    <wv:WebView2 x:Name="Browser" Grid.Row="2" Visibility="Hidden" />
  </Grid>
</Window>
