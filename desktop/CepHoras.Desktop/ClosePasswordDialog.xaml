<Window x:Class="CepHoras.Desktop.ClosePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fechar CEP Horas"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#F5F5F3">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0"
               Text="Digite a senha diária fornecida pela TI para fechar o CEP Horas."
               TextWrapping="Wrap"
               FontSize="15"
               Foreground="#2E302B"
               Margin="0,0,0,14" />
    <PasswordBox x:Name="PasswordInput"
                 Grid.Row="1"
                 MinHeight="38"
                 Padding="9,7"
                 MaxLength="10"
                 PasswordChanged="PasswordInput_Changed" />
    <TextBlock x:Name="ErrorText"
               Grid.Row="2"
               Visibility="Collapsed"
               Text="Senha incorreta. Confira a data deste computador e tente novamente."
               TextWrapping="Wrap"
               Foreground="#B42318"
               Margin="0,10,0,0" />
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="Cancelar" IsCancel="True" MinWidth="92" Padding="12,7" Margin="0,0,8,0" />
      <Button Content="Fechar CEP Horas" IsDefault="True" MinWidth="138" Padding="12,7"
              Background="#DA5D1E" Foreground="White" BorderThickness="0" Click="Confirm_Click" />
    </StackPanel>
  </Grid>
</Window>
