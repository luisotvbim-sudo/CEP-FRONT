<Window x:Class="CepHoras.Desktop.ShutdownPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CEP Horas — liberar desligamento (teste)" Width="480" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F5F5F3">
  <StackPanel Margin="28">
    <TextBlock Text="Autorizar desligamento" FontSize="23" FontWeight="SemiBold" Foreground="#41433F" />
    <TextBlock Margin="0,14,0,20" TextWrapping="Wrap" Foreground="#555750"
               Text="Teste local: informe a senha para liberar uma nova tentativa por 60 segundos. Depois, solicite Desligar novamente no Windows. Este botão não desliga o computador." />
    <Label Content="Senha do teste" Target="{Binding ElementName=Password}" Padding="0,0,0,6" />
    <PasswordBox x:Name="Password" Padding="10" FontSize="17" MaxLength="128" />
    <TextBlock x:Name="Error" TextWrapping="Wrap" Foreground="#B42318" Margin="0,10,0,0" AutomationProperties.LiveSetting="Assertive" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Manter bloqueado" IsCancel="True" Padding="12,9" Margin="0,0,10,0" />
      <Button Content="Liberar por 60 segundos" IsDefault="True" Click="Authorize_Click" Padding="12,9" Background="#D96527" Foreground="White" />
    </StackPanel>
  </StackPanel>
</Window>
